# parser/ (the Zig source tree) isn't a Python package, so setuptools
# doesn't pick it up on its own -- but setup.py's build hook needs it
# present in the sdist to run `zig build` from a clean checkout.
include parser/build.zig
include parser/build.zig.zon
recursive-include parser/src *.zig

# Build outputs, not source -- regenerated by the build hook, shouldn't be
# shipped (and would otherwise get swept in by setup.py's scripts= entry
# referencing a path under here).
prune parser/zig-out
prune parser/.zig-cache
prune uvllang/_zig_libs
